{
  "name": "soapbox",
  "version": "2.0.0",
  "private": true,
  "description": "Turns public app reviews into a weekly product pulse and a facts-only fee explainer, logged through MCP behind a human approval step.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "run:pipeline": "node cli/run.js",
    "mcp:demo": "node mcp/client-demo.js",
    "mcp:server": "node mcp/server.js",
    "test": "node eval/run_eval.js",
    "test:browser": "node eval/browser_check.js",
    "screenshots": "node eval/browser_check.js --shots"
  },
  "license": "MIT"
}
